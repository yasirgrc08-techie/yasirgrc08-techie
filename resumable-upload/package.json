{
  "name": "resumable-upload",
  "version": "1.0.0",
  "description": "Resumable, chunked uploads of multi-GB files over unreliable networks, with file sharing links.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server/index.js",
    "start:chaos": "FAULT_RATE=0.2 FAULT_DELAY_MS=40000 node server/index.js",
    "upload": "node client/upload.js",
    "test": "node --test test/*.test.js"
  },
  "license": "MIT"
}
